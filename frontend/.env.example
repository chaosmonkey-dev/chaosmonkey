# =============================================================================
# CHAOSMONKEY FRONTEND ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update the values for your environment
# This file provides placeholder values for easy setup after cloning

# =============================================================================
# BACKEND API CONFIGURATION
# =============================================================================
# URL of backend API server (including protocol and port)
# Examples:
#   - Local development: http://localhost:8010/api
#   - Docker: http://localhost:9010/api  
#   - Production: https://your-domain.com/api
VITE_API_BASE_URL=http://localhost:8010/api

# Frontend server port (optional, defaults to 5174)
VITE_FRONTEND_PORT=5174

# Backend proxy target (only used if VITE_API_BASE_URL is not set)
# This is used by Vite's proxy in development mode
VITE_API_PROXY_TARGET=http://localhost:8010

# =============================================================================
# PERFORMANCE INSIGHTS CONFIGURATION
# =============================================================================
VITE_FEATURE_PERF_INSIGHTS=1
VITE_PI_DEBUG=false

# =============================================================================
# GITHUB METRIC DRILLDOWN CONFIGURATION
# =============================================================================
VITE_FEATURE_GITHUB_DRILLDOWN=1

# =============================================================================
# AI USAGE SIGNALS CONFIGURATION
# =============================================================================
VITE_FEATURE_AI_USAGE_SIGNALS=1

# =============================================================================
# ORGANIZATION FEATURES
# =============================================================================
VITE_FEATURE_ORGANIZATIONS=1

# =============================================================================
# IDE EXTENSION FEATURES
# =============================================================================
VITE_FEATURE_IDE_CONNECT=1

# =============================================================================
# DEBUGGING AND DEVELOPMENT
# =============================================================================
VITE_DEBUG_MODE=false
VITE_LOG_LEVEL=warn

# Local demo only: hide the Pilot setup banner (API base URL + extension
# download) to recover vertical recording space. Presentation-only.
VITE_HIDE_PILOT_SETUP=false

# =============================================================================
# APPLICATION METADATA
# =============================================================================
VITE_APP_NAME=ChaosMonkey
VITE_APP_VERSION=0.1.0
VITE_APP_DESCRIPTION=Open-source observability for AI-assisted software engineering

# =============================================================================
# SESSION CONFIGURATION
# =============================================================================
VITE_SESSION_TIMEOUT_MINUTES=120
VITE_IDLE_TIMEOUT_MINUTES=30

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
VITE_API_TIMEOUT_MS=30000
VITE_CACHE_TTL_SECONDS=300
VITE_MAX_RETRY_ATTEMPTS=3
