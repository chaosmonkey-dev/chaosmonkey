{
  "name": "chaosmonkey-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:clean": "lsof -ti:${VITE_FRONTEND_PORT:-5174} | xargs kill -9 2>/dev/null; rm -rf node_modules/.vite && vite --host 127.0.0.1",
    "dev:pi-diag": "VITE_PI_DEBUG=1 VITE_RULE_DIAG=1 vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "lint:fix": "eslint . --ext .vue,.js,.ts --fix",
    "test": "vitest run"
  },
  "dependencies": {
    "@types/node": "^25.9.0",
    "axios": "^1.11.0",
    "bootstrap": "^5.3.2",
    "bootstrap-icons": "^1.11.2",
    "chart.js": "^4.5.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.1.0",
    "express": "^4.18.2",
    "pinia": "^3.0.3",
    "typescript": "^6.0.3",
    "vue": "^3.5.17",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.2.1",
    "eslint-plugin-vue": "^10.8.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.3",
    "vite": "^5.4.19",
    "vitest": "^1.6.1"
  },
  "license": "Apache-2.0",
  "optionalDependencies": {
    "@esbuild/linux-arm64": "0.21.5",
    "@esbuild/linux-x64": "0.21.5",
    "@rollup/rollup-linux-arm64-gnu": "4.62.2",
    "@rollup/rollup-linux-arm64-musl": "4.62.2",
    "@rollup/rollup-linux-x64-gnu": "4.62.2",
    "@rollup/rollup-linux-x64-musl": "4.67.4"
  }
}
