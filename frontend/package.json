{
  "name": "chaosMonkey-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:clean": "lsof -ti:${VITE_FRONTEND_PORT:-5174} | xargs kill -9 2>/dev/null; rm -rf node_modules/.vite && vite --host 127.0.0.1",
    "dev:pi-diag": "VITE_PI_DEBUG=1 VITE_RULE_DIAG=1 vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "deploy:prepare": "npm run build && npm run deploy:zip",
    "deploy:zip": "cd dist && zip -r ../chaosMonkey-frontend.zip . && cd ..",
    "deploy:eb": "eb deploy",
    "lint": "eslint . --ext .vue,.js,.ts",
    "lint:fix": "eslint . --ext .vue,.js,.ts --fix",
    "verify:pilot-runtime": "node scripts/verify-pilot-runtime.cjs",
    "verify:pilot-runtime:setup-auth": "node scripts/verify-pilot-runtime.cjs -- --setup-auth",
    "qa:pilot": "playwright test --config=playwright.config.ts; node scripts/summarize-pilot-qa-simple.cjs",
    "qa:pilot:debug": "playwright test --config=playwright.config.ts --debug",
    "qa:pilot:setup": "playwright test --config=playwright.config.ts --project=setup",
    "qa:pilot:pi": "playwright test --config=playwright.config.ts --project=pilot-chromium tests/pilot/performance-insights.spec.ts",
    "qa:pilot:productivity": "playwright test --config=playwright.config.ts --project=pilot-chromium tests/pilot/productivity-by-tool.spec.ts",
    "qa:pilot:spend": "playwright test --config=playwright.config.ts --project=pilot-chromium tests/pilot/ai-spend-roi.spec.ts",
    "qa:pilot:smoke": "playwright test --config=playwright.config.ts --project=pilot-chromium tests/pilot/pilot-smoke.spec.ts",
    "qa:pilot:fast": "playwright test --config=playwright.config.ts --project=pilot-chromium tests/pilot/fast-hydration-check.spec.ts",
    "qa:pilot:report": "playwright show-report playwright-report/pilot"
  },
  "dependencies": {
    "@types/node": "^25.9.0",
    "axios": "^1.11.0",
    "chart.js": "^4.5.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "date-fns": "^4.1.0",
    "express": "^4.18.2",
    "pinia": "^3.0.3",
    "puppeteer": "^25.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vue": "^3.5.17",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.2.1",
    "eslint-plugin-vue": "^10.8.0",
    "playwright": "^1.44.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.3",
    "vite": "^5.4.19"
  }
}
