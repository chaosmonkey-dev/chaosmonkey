files:
  "/etc/httpd/conf.d/01_laravel.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      <VirtualHost *:80>
        DocumentRoot /var/app/current/public
        <Directory /var/app/current/public>
          AllowOverride All
          Require all granted
        </Directory>
      </VirtualHost>
