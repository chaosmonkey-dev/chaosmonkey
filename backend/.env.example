# =============================================================================
# CHAOSMONKEY BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and update the values for your environment
# This file provides placeholder values for easy setup after cloning

# =============================================================================
# LARAVEL APP CONFIGURATION
# =============================================================================
APP_NAME=ChaosMonkey
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8010
APP_PORT=8010

# =============================================================================
# FRONTEND URL CONFIGURATION
# =============================================================================
# URL where the frontend is served (used for CORS and OAuth redirects)
# Examples:
#   - Local development: http://localhost:5174
#   - Docker: http://localhost:5174
#   - Production: https://your-domain.com (whatever URL users actually visit)
APP_FRONTEND_URL=http://localhost:5174

# Additional frontend URLs for CORS (optional)
FRONTEND_DEV_URL=http://localhost:5174
FRONTEND_DEV_ALT_URL=http://localhost:5175
FRONTEND_LOCALHOST_URL=http://127.0.0.1:5174
FRONTEND_LOCALHOST_ALT_URL=http://127.0.0.1:5175

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_CONNECTION=sqlite
# Database path is relative to the Laravel backend directory
# Portable across local development, EC2, and other deployment environments
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

# Alternative MySQL configuration (comment out SQLite above if using MySQL)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=chaosmonkey
# DB_USERNAME=root
# DB_PASSWORD=

# =============================================================================
# GITHUB OAUTH CONFIGURATION
# =============================================================================
# Get these from: https://github.com/settings/applications/new
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# GitHub OAuth redirect URL (will be auto-generated from APP_URL or GITHUB_OAUTH_REDIRECT)
# Override this in production if your backend runs on a different host/port
GITHUB_OAUTH_REDIRECT=http://localhost:8010/api/github/oauth/callback

# =============================================================================
# ATLASSIAN OAUTH CONFIGURATION (Optional)
# =============================================================================
# Get these from: https://developer.atlassian.com/console/my-apps
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# =============================================================================
# GITHUB DELIVERY METRICS
# =============================================================================
GITHUB_DELIVERY_METRICS_ENABLED=true
GITHUB_DELIVERY_METRICS_TTL_SECONDS=900
GITHUB_DELIVERY_METRICS_REPO_LIMIT=10
GITHUB_DELIVERY_METRICS_TIMEOUT_SECONDS=30

# =============================================================================
# METRICS AND PERFORMANCE INSIGHTS
# =============================================================================
METRICS_DEBUG=false
PI_DEBUG=false

# =============================================================================
# DEMO MODE CONFIGURATION
# =============================================================================
DEMO_MODE=false

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# =============================================================================
# QUEUE CONFIGURATION
# =============================================================================
QUEUE_CONNECTION=sync

# =============================================================================
# LOGGING
# =============================================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# These are automatically built from APP_FRONTEND_URL and other frontend URLs
# But you can override them here if needed
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*

# =============================================================================
# SESSION CONFIGURATION
# =============================================================================
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIES=false
SESSION_SAME_SITE=lax

# =============================================================================
# TELEMETRY CONFIGURATION
# =============================================================================
TELEMETRY_ENABLED=true
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_MAX_EVENTS_PER_REQUEST=1000

# =============================================================================
# IDE EXTENSION CONFIGURATION
# =============================================================================
IDE_CONNECT_ENABLED=true
IDE_CONNECT_CODE_TTL=300
IDE_CONNECT_SESSION_TTL=3600

# =============================================================================
# ORGANIZATION CONFIGURATION
# =============================================================================
ORGANIZATION_INVITES_ENABLED=true
ORGANIZATION_DEFAULT_ROLE=developer

# =============================================================================
# PRODUCTION SAFETY
# =============================================================================
BCRYPT_ROUNDS=12
HASH_DRIVER=bcrypt
IMAGE_DRIVER=gd

# =============================================================================
# PILOT SINGLE-TENANT ISOLATION
# =============================================================================
# When PILOT_SINGLE_TENANT_ORG_SLUG is set, all direct OAuth logins (without
# invite) are assigned to this org instead of creating a personal org.
# Leave blank for normal multi-tenant mode.
PILOT_SINGLE_TENANT_ORG_SLUG=
# Optional org slug for single-tenant pilot mode. When set, metrics data is scoped to this org.
PILOT_SINGLE_TENANT_ORG_SLUG=
PILOT_SINGLE_TENANT_ORG_NAME=

# Comma-separated GitHub logins to exclude from customer metrics token retrieval.
# Support staff who log in via OAuth will not have their tokens used for metrics.
PILOT_SUPPORT_GITHUB_LOGINS=
